rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // --------------------------------------------------------------------------------
    // Kullanici verisi tasiyan koleksiyonlar ACIKCA yazilir.
    //
    // Eskiden tek bir `match /{collection}/{docId}` kalibi vardi. Kaldirildi, cunku:
    //
    // 1. Kurallar BIRLESIM (OR) mantigiyla degerlendirilir: bir istek, eslesein
    //    kurallardan HERHANGI biri izin veriyorsa gecer. Yani genis bir kural, daha dar
    //    bir kural eklenerek daraltilamaz. TASK-038'de bir koleksiyon uyelik tabanli
    //    kurala tasindiginda blanket kural eski `userId` yolunu acik birakmaya devam
    //    ederdi ve gocme guvenlik acisindan hicbir sey degistirmezdi.
    // 2. Blanket kalip HERHANGI bir koleksiyon adini kapsiyordu: kimlik dogrulanmis bir
    //    kullanici `userId` alanini kendi uid'iyle doldurdugu surece istedigi adda
    //    koleksiyon olusturup veri yazabiliyordu (en az yetki ilkesine aykiri).
    //
    // Yeni bir koleksiyon eklenirken buraya da bir `match` blogu eklenmelidir; aksi halde
    // erisim reddedilir. `src/services/firestoreRules.test.js` bunu kapiya baglar:
    // koddaki koleksiyonlarla bu dosyadaki bloklar ayrisirsa test kirilir.
    // --------------------------------------------------------------------------------

    function signedIn() {
      return request.auth != null;
    }

    // `resource == null` dali TASK-033'ten geliyor: silinmis bir dokumani okurken kural
    // `resource.data.userId`'ye dokunursa `permission-denied` doner ve cagiran taraf
    // "silinmis mi" sorusunu soramaz. Surum kontrolu (rev) bu davranisa dayaniyor.
    function canReadOwned() {
      return signedIn() && (resource == null || request.auth.uid == resource.data.userId);
    }

    function canWriteOwned() {
      return signedIn() && request.auth.uid == resource.data.userId;
    }

    function canCreateOwned() {
      return signedIn() && request.auth.uid == request.resource.data.userId;
    }

    // Guncelleme HEM eski HEM yeni sahibin ben olmasini ister.
    //
    // Yalnizca eskiye bakmak yetmiyordu: kendi kaydimin `userId` alanini baskasinin
    // uid'i yapip ONUN defterine kayit enjekte edebiliyordum. Veri sizintisi degil
    // (B'nin kayitlarini hala okuyamiyorum) ama bir muhasebe urununde baska klinigin
    // defterine sahte borc yazilabilmesi kabul edilemez. BAKIM-002'de yazilan emulator
    // testi bu acigi kanitladi; uygulamada `userId`'yi degistiren mesru bir yol yok.
    //
    // `delete` bu kontrolu ISTEYEMEZ: silmede `request.resource` yoktur.
    function canUpdateOwned() {
      return canWriteOwned() && canCreateOwned();
    }

    match /customers/{docId} {
      allow read: if canReadOwned();
      allow create: if canCreateOwned();
      allow update: if canUpdateOwned();
      allow delete: if canWriteOwned();
    }

    match /drugs/{docId} {
      allow read: if canReadOwned();
      allow create: if canCreateOwned();
      allow update: if canUpdateOwned();
      allow delete: if canWriteOwned();
    }

    match /serviceDebts/{docId} {
      allow read: if canReadOwned();
      allow create: if canCreateOwned();
      allow update: if canUpdateOwned();
      allow delete: if canWriteOwned();
    }

    match /drugDebts/{docId} {
      allow read: if canReadOwned();
      allow create: if canCreateOwned();
      allow update: if canUpdateOwned();
      allow delete: if canWriteOwned();
    }

    match /transactions/{docId} {
      allow read: if canReadOwned();
      allow create: if canCreateOwned();
      allow update: if canUpdateOwned();
      allow delete: if canWriteOwned();
    }

    // Ortak ilac katalogu (TASK-037) — SALT OKUNUR, sahipsiz.
    //
    // `userId` tasimaz: butun kliniklerin paylastigi bir urun referansidir. Yazma her
    // istemciye kapali; katalogu yalnizca urun sahibi Admin SDK ile gunceller
    // (`scripts/loadDrugCatalog.js`). Yazma acik kalsaydi herhangi bir veteriner tum
    // musterilerin katalogunu degistirebilirdi — cok kiracili bir uruncde ciddi bir acik.
    match /drugCatalog/{docId} {
      allow read: if signedIn();
      allow write: if false;
    }
  }
}
