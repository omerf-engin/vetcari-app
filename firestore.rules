rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Sadece giriş yapmış kullanıcıların okuma/yazma yapmasına izin verir.
    // Uygulama içinde "Kayıt Ol" butonu olmadığı için sadece Firebase Console'dan 
    // eklediğiniz kişiler giriş yapıp veritabanını görebilecek/değiştirebilecektir.
    function isAuthenticated() {
      return request.auth != null;
    }

    // İsterseniz daha da kısıtlamak için aşağıdaki fonksiyonu kullanabilirsiniz:
    // function isAdmin() {
    //   return request.auth != null && request.auth.token.email == "admin@egeisten.com.tr";
    // }

    match /{document=**} {
      allow read, write: if isAuthenticated();
    }
  }
}
