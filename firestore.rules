rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // --------------------------------------------------------------------------------
    // Kullanici verisi tasiyan koleksiyonlar ACIKCA yazilir.
    //
    // Eskiden tek bir `match /{collection}/{docId}` kalibi vardi. Kaldirildi, cunku:
    //
    // 1. Kurallar BIRLESIM (OR) mantigiyla degerlendirilir: bir istek, eslesein
    //    kurallardan HERHANGI biri izin veriyorsa gecer. Yani genis bir kural, daha dar
    //    bir kural eklenerek daraltilamaz. TASK-038'de bir koleksiyon uyelik tabanli
    //    kurala tasindiginda blanket kural eski `userId` yolunu acik birakmaya devam
    //    ederdi ve gocme guvenlik acisindan hicbir sey degistirmezdi.
    // 2. Blanket kalip HERHANGI bir koleksiyon adini kapsiyordu: kimlik dogrulanmis bir
    //    kullanici `userId` alanini kendi uid'iyle doldurdugu surece istedigi adda
    //    koleksiyon olusturup veri yazabiliyordu (en az yetki ilkesine aykiri).
    //
    // Yeni bir koleksiyon eklenirken buraya da bir `match` blogu eklenmelidir; aksi halde
    // erisim reddedilir. `src/services/firestoreRules.test.js` bunu kapiya baglar:
    // koddaki koleksiyonlarla bu dosyadaki bloklar ayrisirsa test kirilir.
    // --------------------------------------------------------------------------------

    function signedIn() {
      return request.auth != null;
    }

    // --------------------------------------------------------------------------------
    // GECIS DONEMI (TASK-038a, genislet/goc et/daralt).
    //
    // Bir dokuman su an IKI yoldan sahiplenilebilir:
    //   ESKI: `resource.data.userId == request.auth.uid`  (tek kullanicili model)
    //   YENI: uyeligimdeki `clinicId`, dokumanin `clinicId`'si ile ayni
    //
    // Ikisi birlikte acik tutuluyor ki goc scripti calisirken ve sorgular henuz
    // `userId` uzerindeyken uygulama kesintisiz calissin. Goc oturunca ESKI yol
    // kaldirilacak (6. asama) ve `tests/rules/` o zaman eski yolun REDDEDILDIGINI sinar.
    // --------------------------------------------------------------------------------

    // Tek klinik uyeligi karari sayesinde dokuman kimligi dogrudan uid; kural tek
    // dokuman okumasiyla hem varligi hem `clinicId`'yi ogrenir. `&&` kisa devre yaptigi
    // icin uyelik yoksa `get()` hic calismaz, ayni yol iki kez okunmus da olmaz.
    function isMember() {
      return signedIn()
        && exists(/databases/$(database)/documents/memberships/$(request.auth.uid));
    }

    function myClinicId() {
      return get(/databases/$(database)/documents/memberships/$(request.auth.uid)).data.clinicId;
    }

    function inClinicExisting() {
      return isMember() && myClinicId() == resource.data.clinicId;
    }

    function inClinicIncoming() {
      return isMember() && myClinicId() == request.resource.data.clinicId;
    }

    // Gecis doneminin KRITIK kilidi.
    //
    // Eski `userId` yolu acikken, kendi kaydima BASKA bir klinigin `clinicId`'sini
    // yazabilseydim, BAKIM-002'de kapatilan enjeksiyon acigi gecis penceresinde geri
    // gelirdi (bu sefer `userId` degil `clinicId` uzerinden). Bu yuzden: yazilan
    // dokumanda `clinicId` VARSA mutlaka benim klinigim olmali.
    function incomingClinicSafe() {
      return !('clinicId' in request.resource.data) || inClinicIncoming();
    }

    // `resource == null` dali TASK-033'ten geliyor: silinmis bir dokumani okurken kural
    // `resource.data.userId`'ye dokunursa `permission-denied` doner ve cagiran taraf
    // "silinmis mi" sorusunu soramaz. Surum kontrolu (rev) bu davranisa dayaniyor.
    function canReadOwned() {
      return signedIn() && (resource == null
        || request.auth.uid == resource.data.userId
        || inClinicExisting());
    }

    function canWriteOwned() {
      return signedIn() && (request.auth.uid == resource.data.userId || inClinicExisting());
    }

    function canCreateOwned() {
      return signedIn()
        && (request.auth.uid == request.resource.data.userId || inClinicIncoming())
        && incomingClinicSafe();
    }

    // Guncelleme HEM eski HEM yeni sahibin ben olmasini ister.
    //
    // Yalnizca eskiye bakmak yetmiyordu: kendi kaydimin `userId` alanini baskasinin
    // uid'i yapip ONUN defterine kayit enjekte edebiliyordum. Veri sizintisi degil
    // (B'nin kayitlarini hala okuyamiyorum) ama bir muhasebe urununde baska klinigin
    // defterine sahte borc yazilabilmesi kabul edilemez. BAKIM-002'de yazilan emulator
    // testi bu acigi kanitladi; uygulamada `userId`'yi degistiren mesru bir yol yok.
    //
    // `delete` bu kontrolu ISTEYEMEZ: silmede `request.resource` yoktur.
    function canUpdateOwned() {
      return canWriteOwned() && canCreateOwned();
    }

    match /customers/{docId} {
      allow read: if canReadOwned();
      allow create: if canCreateOwned();
      allow update: if canUpdateOwned();
      allow delete: if canWriteOwned();
    }

    match /drugs/{docId} {
      allow read: if canReadOwned();
      allow create: if canCreateOwned();
      allow update: if canUpdateOwned();
      allow delete: if canWriteOwned();
    }

    match /serviceDebts/{docId} {
      allow read: if canReadOwned();
      allow create: if canCreateOwned();
      allow update: if canUpdateOwned();
      allow delete: if canWriteOwned();
    }

    match /drugDebts/{docId} {
      allow read: if canReadOwned();
      allow create: if canCreateOwned();
      allow update: if canUpdateOwned();
      allow delete: if canWriteOwned();
    }

    match /transactions/{docId} {
      allow read: if canReadOwned();
      allow create: if canCreateOwned();
      allow update: if canUpdateOwned();
      allow delete: if canWriteOwned();
    }

    // Ortak ilac katalogu (TASK-037) — SALT OKUNUR, sahipsiz.
    //
    // `userId` tasimaz: butun kliniklerin paylastigi bir urun referansidir. Yazma her
    // istemciye kapali; katalogu yalnizca urun sahibi Admin SDK ile gunceller
    // (`scripts/loadDrugCatalog.js`). Yazma acik kalsaydi herhangi bir veteriner tum
    // musterilerin katalogunu degistirebilirdi — cok kiracili bir uruncde ciddi bir acik.
    match /drugCatalog/{docId} {
      allow read: if signedIn();
      allow write: if false;
    }

    // Klinik kimligi (TASK-038a) — istemciye SALT OKUNUR.
    //
    // Uyelik ve klinik kayitlarini yalnizca goc scripti (Admin SDK) olusturur. Istemciye
    // yazma acilsaydi bir kullanici kendini istedigi klinige uye yapip o defteri acabilirdi
    // — yani butun yetkilendirmenin anahtarini kendisi basardi. Bu koleksiyonlar tum
    // sahiplik kontrolunun dayanagi oldugu icin en dar sekilde tutuluyor.
    //
    // Self-servis davet akisi TASK-038b'de gelecek ve KENDI kurallariyla acilacak;
    // o zamana kadar ikinci kullanici elle (script ile) baglanir.
    match /memberships/{userId} {
      allow read: if signedIn() && request.auth.uid == userId;
      allow write: if false;
    }

    // NOT: `clinics` koleksiyonunun kural blogu BILEREK yok.
    //
    // Goc scripti (Admin SDK) klinik dokumanlarini olusturur ama uygulama henuz hicbirini
    // OKUMUYOR — klinik adi/koltuk sayisi TASK-038b'nin arayuzunde gerekecek. Kurala
    // simdiden yazmak, hicbir seyin kullanmadigi bir erisim acmak olurdu; blogu olmayan
    // koleksiyon reddedilir, yani varsayilan fail-closed. Arayuz okumaya basladiginda
    // kendi blogu eklenecek.
  }
}
