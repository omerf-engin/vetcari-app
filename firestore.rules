rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    match /{collection}/{docId} {
      // NOT (2026-08-30): bu dosya repoda guncel ama Firebase'e YAYINLANMADI.
      // Yayinlamak icin: firebase deploy --only firestore:rules   (bkz. docs/ROADMAP.md)
      //
      // `resource == null` dali surum kontrolunu iyilestirir (TASK-033): silinmis bir dokumani
      // okumak `resource.data.userId` uzerinden degerlendirilirse kural permission-denied
      // verir ve `snap.exists() === false` yerine hata doner. O zaman "borc silinmis mi"
      // sorusu transaction icinde sorulamaz. Kimlik dogrulamasi hala zorunlu; var olan
      // dokumanlarda sahiplik kontrolu degismedi.
      allow read: if request.auth != null
        && (resource == null || request.auth.uid == resource.data.userId);
      allow update, delete: if request.auth != null
        && request.auth.uid == resource.data.userId;
      allow create: if request.auth != null
        && request.auth.uid == request.resource.data.userId;
    }
  }
}
