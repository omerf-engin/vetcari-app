rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // --------------------------------------------------------------------------------
    // Kullanici verisi tasiyan koleksiyonlar ACIKCA yazilir.
    //
    // Eskiden tek bir `match /{collection}/{docId}` kalibi vardi. Kaldirildi, cunku:
    //
    // 1. Kurallar BIRLESIM (OR) mantigiyla degerlendirilir: bir istek, eslesein
    //    kurallardan HERHANGI biri izin veriyorsa gecer. Yani genis bir kural, daha dar
    //    bir kural eklenerek daraltilamaz. TASK-038'de bir koleksiyon uyelik tabanli
    //    kurala tasindiginda blanket kural eski `userId` yolunu acik birakmaya devam
    //    ederdi ve gocme guvenlik acisindan hicbir sey degistirmezdi.
    // 2. Blanket kalip HERHANGI bir koleksiyon adini kapsiyordu: kimlik dogrulanmis bir
    //    kullanici `userId` alanini kendi uid'iyle doldurdugu surece istedigi adda
    //    koleksiyon olusturup veri yazabiliyordu (en az yetki ilkesine aykiri).
    //
    // Yeni bir koleksiyon eklenirken buraya da bir `match` blogu eklenmelidir; aksi halde
    // erisim reddedilir. `src/services/firestoreRules.test.js` bunu kapiya baglar:
    // koddaki koleksiyonlarla bu dosyadaki bloklar ayrisirsa test kirilir.
    // --------------------------------------------------------------------------------

    function signedIn() {
      return request.auth != null;
    }

    // --------------------------------------------------------------------------------
    // SAHIPLIK = KLINIK UYELIGI (TASK-038a; 6. asamada daraltildi, 2026-09-24).
    //
    // Erisim TEK yoldan: uyeligimdeki `clinicId`, dokumanin `clinicId`'si ile ayni.
    // `userId` artik yetki TASIMAZ; "bu kaydi kim girdi" bilgisidir. Bu yuzden
    // guncellemede degistirilemez (bkz. `keepsActor`).
    //
    // Gecis doneminde eski `userId == request.auth.uid` yolu da acikti. Kaldirildi, cunku
    // UYELIK ARAMIYORDU: klinikten cikarilan personel kendi girdigi kayitlari okumaya,
    // listelemeye ve borc/islem kayitlarini SILMEYE devam ediyordu; uyeligi olmayan
    // herhangi bir hesap da `clinicId`'siz kayit yaratabiliyordu (ikisi de emulatorde
    // olculdu). Kaldirmadan once uretimde `clinicId`'siz dokuman sayisi 0 olculdu.
    // --------------------------------------------------------------------------------

    // Tek klinik uyeligi karari sayesinde dokuman kimligi dogrudan uid; kural tek
    // dokuman okumasiyla hem varligi hem `clinicId`'yi ogrenir. `&&` kisa devre yaptigi
    // icin uyelik yoksa `get()` hic calismaz, ayni yol iki kez okunmus da olmaz.
    function isMember() {
      return signedIn()
        && exists(/databases/$(database)/documents/memberships/$(request.auth.uid));
    }

    function myClinicId() {
      return get(/databases/$(database)/documents/memberships/$(request.auth.uid)).data.clinicId;
    }

    function myRole() {
      return get(/databases/$(database)/documents/memberships/$(request.auth.uid)).data.role;
    }

    /** Sahip mi? Rol tabanli yazma kisitlarinin tek kaynagi (TASK-038b). */
    function isOwner() {
      return isMember() && myRole() == 'owner';
    }

    /** Davet dokumaninin kimligi KUCUK HARFLI e-postadir.
     *
     * Istemci auth kullanicilarini e-postayla SORGULAYAMAZ; kuralin daveti bulabilmesi
     * icin kimligin token'dan turetilebilir olmasi sart. `.lower()` iki tarafi da
     * normalize eder, boylece "Ali@X.com" ile "ali@x.com" ayni daveti bulur.
     * (Emulatorde olculdu — bkz. TASK-038b.)
     */
    function inviteKey() {
      return request.auth.token.email.lower();
    }

    function myInvitePath() {
      return /databases/$(database)/documents/invites/$(inviteKey());
    }

    function myInvite() {
      return get(myInvitePath()).data;
    }

    function inClinicExisting() {
      return isMember() && myClinicId() == resource.data.clinicId;
    }

    function inClinicIncoming() {
      return isMember() && myClinicId() == request.resource.data.clinicId;
    }

    // `resource == null` dali TASK-033'ten geliyor: silinmis bir dokumani okurken kural
    // `resource.data`ya dokunursa `permission-denied` doner ve cagiran taraf "silinmis mi"
    // sorusunu soramaz. Surum kontrolu (rev) bu davranisa dayaniyor.
    function canReadOwned() {
      return signedIn() && (resource == null || inClinicExisting());
    }

    function canWriteOwned() {
      return inClinicExisting();
    }

    // `inClinicIncoming` alanin hem VARLIGINI hem esitligini ister: `clinicId`'siz ya da
    // baska klinigin `clinicId`'sini tasiyan kayit yaratilamaz. Gecis doneminde bunu ayri
    // bir `incomingClinicSafe` sagliyordu; eski yol gidince gereksiz kaldi.
    function canCreateOwned() {
      return inClinicIncoming();
    }

    // Kaydi kim girdiyse `userId` odur; guncelleme bunu degistiremez. Kontrolun yalnizca
    // istemcide durdugu yerlerde (baskasinin islemini iptal, tahsilat/zam geri alma)
    // koruma ATIFTIR — atif yeniden yazilabilseydi o koruma da kalmazdi.
    //
    // Mesru bir yol bunu bozmaz: hicbir guncelleme `userId` yazmaz, tahsilat geri almanin
    // `set(ref, before)`'u ise `before`'daki ilk giren kisiyi geri yazar (uretimde 106
    // `before`'un 106'si `userId` tasiyor).
    function keepsActor() {
      return request.resource.data.userId == resource.data.userId;
    }

    // Guncelleme HEM mevcut HEM yazilan dokumanin benim klinigimde olmasini ister.
    // Yalnizca mevcuda bakmak, kendi kaydimin `clinicId`'sini baska klinige cevirip ONUN
    // defterine kayit enjekte etmeye izin verirdi — BAKIM-002'de `userId` uzerinden
    // bulunan acigin klinik modelindeki karsiligi.
    //
    // `delete` bu kontrolu ISTEYEMEZ: silmede `request.resource` yoktur.
    function canUpdateOwned() {
      return canWriteOwned() && canCreateOwned() && keepsActor();
    }

    // Olusturan kisi kendini yazar. Musteri, ilac ve islem logu HER ZAMAN o an, islemi
    // yapanin adiyla yaratilir; islem logu denetim izinin kendisidir ve baskasi adina
    // yazilabilseydi "kim ne yapti" sorusunun cevabi uydurulabilirdi.
    //
    // Borclarda (`serviceDebts`, `drugDebts`) ISTENMEZ: tahsilat geri alma supurulmus bir
    // borcu ayni kimlikle, borcu ilk GIRENIN `userId`'siyle yeniden yaratir — geri alan
    // sahip, borcu personel girdiyse bu kontrolu gecemezdi.
    function createdByMe() {
      return request.resource.data.userId == request.auth.uid;
    }

    // Musteri silmek geri donusu olmayan bir istir: borclari ve tum islem gecmisi de
    // gider. Personel silemez (urun karari 2026-09-23).
    //
    // DIKKAT: `deleteCustomer` atomik DEGIL (450'lik parcalar, musteri dokumani en sonda).
    // Bu kural tek basina kalsaydi, personelin denemesi gecmisi silip son adimda
    // reddedilebilirdi. Asil koruma fonksiyonun BASINDAKI rol kontrolu; burasi ikinci
    // savunma hatti.
    match /customers/{docId} {
      allow read: if canReadOwned();
      allow create: if canCreateOwned() && createdByMe();
      allow update: if canUpdateOwned();
      allow delete: if canWriteOwned() && isOwner();
    }

    // Fiyat degisikligi enflasyon zinciriyle TUM acik borclari etkiliyor; silme de
    // gecmisi bozar. Ikisi de sahibe ozel (urun karari 2026-09-23).
    //
    // Fiyat DISINDAKI guncellemeler (ornegin ad duzeltmesi) personele acik kalir:
    // kosul yalnizca `price` degistiginde sahiplik arar. `updateDrugPrice` tek bir
    // `writeBatch` oldugu icin buradaki ret islemin TAMAMINI durdurur — yarim kalmaz.
    match /drugs/{docId} {
      allow read: if canReadOwned();
      allow create: if canCreateOwned() && createdByMe();
      allow update: if canUpdateOwned()
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['price'])
            || isOwner());
      allow delete: if canWriteOwned() && isOwner();
    }

    match /serviceDebts/{docId} {
      allow read: if canReadOwned();
      allow create: if canCreateOwned();
      allow update: if canUpdateOwned();
      allow delete: if canWriteOwned();
    }

    match /drugDebts/{docId} {
      allow read: if canReadOwned();
      allow create: if canCreateOwned();
      allow update: if canUpdateOwned();
      allow delete: if canWriteOwned();
    }

    match /transactions/{docId} {
      allow read: if canReadOwned();
      allow create: if canCreateOwned() && createdByMe();
      allow update: if canUpdateOwned();
      allow delete: if canWriteOwned();
    }

    // Ortak ilac katalogu (TASK-037) — SALT OKUNUR, sahipsiz.
    //
    // `userId` tasimaz: butun kliniklerin paylastigi bir urun referansidir. Yazma her
    // istemciye kapali; katalogu yalnizca urun sahibi Admin SDK ile gunceller
    // (`scripts/loadDrugCatalog.js`). Yazma acik kalsaydi herhangi bir veteriner tum
    // musterilerin katalogunu degistirebilirdi — cok kiracili bir uruncde ciddi bir acik.
    match /drugCatalog/{docId} {
      allow read: if signedIn();
      allow write: if false;
    }


    // --------------------------------------------------------------------------------
    // DAVET (TASK-038b)
    //
    // Sahip, personelin e-postasiyla bir davet olusturur; personel giris yapinca KENDI
    // uyeligini bu davete dayanarak yaratir. Davetin kimligi kucuk harfli e-postadir
    // (bkz. `inviteKey`) cunku kural "bu kullaniciyi kim davet etti" sorusunu ancak
    // token'dan turetilen bir yolla cevaplayabilir.
    // --------------------------------------------------------------------------------
    match /invites/{emailKey} {
      // Davetli KENDI davetini gorur; sahip kendi kliniginin davetlerini gorur
      allow read: if signedIn()
        && (emailKey == inviteKey() || (isOwner() && myClinicId() == resource.data.clinicId));

      // Yalnizca sahip davet eder, yalnizca KENDI klinigine, yalnizca `staff` olarak.
      // `role` serbest birakilsaydi sahip birini `owner` davet edip yetki dagitabilirdi.
      allow create: if isOwner()
        && request.resource.data.clinicId == myClinicId()
        && request.resource.data.role == 'staff'
        && emailKey == request.resource.data.email;

      // Daveti geri almak = silmek. Guncelleme yok: degistirilecek bir sey yok, ve
      // `clinicId`/`role` degistirilebilseydi kilit anlamini yitirirdi.
      //
      // Davetli de KENDI davetini silebilir. Katildiktan sonra davet dokumaninin kalmasi
      // sahibin "bekleyen davetler" listesinde katilmis birini gosterirdi. Yetki genislemesi
      // DEGIL: kisi yalnizca kendi e-postasinin davetini silebiliyor ve bu ona hicbir sey
      // kazandirmiyor — olsa olsa kendi katilma hakkini kaybeder.
      allow delete: if (isOwner() && myClinicId() == resource.data.clinicId)
        || emailKey == inviteKey();
      allow update: if false;
    }

    // --------------------------------------------------------------------------------
    // UYELIK — defterin anahtari
    //
    // `create` istemciye ACIK ama YALNIZCA esleşen bir davet varsa. Bu blogun her satiri
    // bir saldiriyi kapatiyor:
    //   - `request.auth.uid == userId`  -> baskasi adina uyelik yaratilamaz
    //   - davet VARLIGI                 -> davetsiz kimse deftere giremez
    //   - clinicId davetten kopyalanir  -> davet alan baska bir klinige giremez
    //   - role == 'staff'               -> davetle kimse `owner` olamaz
    // --------------------------------------------------------------------------------
    match /memberships/{userId} {
      // Kendi kaydi; ayrica sahip personel listesini gorebilmeli
      allow read: if signedIn()
        && (request.auth.uid == userId
            || (isOwner() && myClinicId() == resource.data.clinicId));

      allow create: if signedIn()
        && request.auth.uid == userId
        && exists(myInvitePath())
        && request.resource.data.clinicId == myInvite().clinicId
        && request.resource.data.role == myInvite().role
        && request.resource.data.role == 'staff';

      // Personeli cikarmak: yalnizca ayni klinigin sahibi, KENDI uyeligi haric.
      // Sahip kendini atabilseydi klinik sahipsiz kalir ve kimse davet edemezdi.
      allow delete: if isOwner()
        && myClinicId() == resource.data.clinicId
        && request.auth.uid != userId;

      // Rol degistirme yok: `staff` kendini `owner` yapamasin diye guncelleme kapali.
      allow update: if false;
    }

    // Klinik bilgisi (ad, koltuk sayisi) arayuzde gosteriliyor; yazma Admin SDK'da kalir.
    match /clinics/{clinicId} {
      allow read: if isMember() && myClinicId() == clinicId;
      allow write: if false;
    }

  }
}
